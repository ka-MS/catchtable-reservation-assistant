{
  "manifest_version": 3,
  "name": "Catchtable Reservation Assistant",
  "version": "1.1.4",
  "description": "예약 오픈 시각에 목표 슬롯을 감지하고, 허용한 경우 CatchPay 결제와 최종 예약까지 진행합니다.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://app.catchtable.co.kr/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "icons": {
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Catchtable Reservation Assistant",
    "default_icon": {
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
